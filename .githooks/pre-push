#!/bin/sh
# Run CI's gate before the push, not after it.
#
# `pnpm check` is exactly what the `quality` job runs, so a push that passes
# here cannot fail that job. That matters now that the development repository
# is private and Actions minutes are metered: a failed CI run is a few minutes
# of quota spent to learn something this would have said for free, and the
# round trip through a red check costs another full run to clear.
#
# The browser suite is deliberately not here. It needs a built server, takes
# minutes, and is the one thing CI is genuinely better placed to run.
#
# Two ways past it, for when you already know:
#   git push --no-verify          skip the hook entirely
#   VADEVI_SKIP_CHECK=1 git push  same, without forgetting the flag mid-rebase

# In the public mirror (marked by PUBLIC_MIRROR.md, which the source tree does
# not carry), no commit may go out under a personal identity. The initial
# export is committed as "Va de Vi <noreply@example.invalid>"; a commit made
# afterwards in the clone picks up whatever identity git has configured, and
# that is how a maintainer's address reached the public record once. This is
# not skipped by VADEVI_SKIP_CHECK: it is not a check that can already be known.
if [ -f PUBLIC_MIRROR.md ]; then
	offending=$(git log --format='%ae%n%ce' origin/main..HEAD 2>/dev/null || git log --format='%ae%n%ce' HEAD)
	offending=$(printf '%s\n' "$offending" | grep -v -e '@example.invalid$' -e '@users.noreply.github.com$' | sort -u)
	if [ -n "$offending" ]; then
		echo "pre-push: a commit in this public mirror carries a personal e-mail address."
		echo "  Set the neutral identity for this clone and amend or rebase the commit:"
		echo "    git config user.name 'Va de Vi'"
		echo "    git config user.email 'noreply@example.invalid'"
		echo "  Nothing was pushed."
		exit 1
	fi
fi

if [ "${VADEVI_SKIP_CHECK:-}" = "1" ]; then
	echo "pre-push: check skipped (VADEVI_SKIP_CHECK=1)"
	exit 0
fi

echo "pre-push: running pnpm check — 'git push --no-verify' skips it"

if ! pnpm check; then
	echo ""
	echo "pre-push: pnpm check failed, so nothing was pushed."
	echo "  Fix it, or push with --no-verify if you meant to."
	exit 1
fi

# Dependencies and build output
node_modules/
.pnpm-store/
dist/
coverage/
playwright-report/
test-results/

# Local provider and emulator state
.wrangler/
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Local environment and secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Temporary and editor files
tmp/
.DS_Store
Thumbs.db
*.log
*.tsbuildinfo

# Deployment-specific Wrangler configuration
wrangler.preview.jsonc
wrangler.production.jsonc

# Backups and database dumps: a Space's photographs and rows, which the
# scripts write locally and which must never be committed. The release scan
# refuses them even if forced in.
r2-backup*/
backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.dump
backup*.sql

# Terms that must never reach a public mirror. Local, never committed —
# committing them would publish exactly what they exist to hold back.
.mirror-denylist
.ux-shots/

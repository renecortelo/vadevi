{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vadevi-api-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vadevi-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vadevi-test-media",
    },
  ],
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "0.1.0",
    "AI_PROVIDER": "none",
    "EXTERNAL_API_USER_AGENT": "VaDeVi/0.1 (https://example.invalid/contact)",
    "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
    "FIREBASE_AUTH_DOMAIN": "localhost",
    "FIREBASE_PROJECT_ID": "demo-vadevi",
    "FIREBASE_WEB_API_KEY": "local-emulator-placeholder",
    "RESEARCH_PROVIDER": "none",
  },
}

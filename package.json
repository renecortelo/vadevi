{
  "name": "va-de-vi",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Private, collaborative wine memory and tasting PWA.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "backup:r2": "tsx scripts/backup-r2.ts",
    "brand:check": "tsx scripts/generate-brand.ts --check",
    "brand:generate": "tsx scripts/generate-brand.ts",
    "build": "pnpm --filter @vadevi/web build && pnpm --filter @vadevi/api build",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check && pnpm i18n:check && pnpm docs:check && pnpm migrations:check && pnpm brand:check && pnpm notices:check && pnpm build && pnpm bundle:check && pnpm scan:release",
    "docs:check": "tsx scripts/check-docs-caps.ts",
    "deploy:preview": "tsx scripts/deploy.ts --config wrangler.preview.jsonc",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "wrangler dev --config wrangler.example.jsonc --local --port 8787",
    "dev:auth": "firebase emulators:start --only auth --project demo-vadevi",
    "dev:web": "pnpm --filter @vadevi/web dev",
    "e2e": "playwright test --project=chromium-desktop --project=chromium-320",
    "e2e:install": "playwright install chromium",
    "e2e:resilience": "playwright test --project=resilience",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/verify-i18n.ts",
    "i18n:export": "tsx scripts/translations-review.ts export",
    "i18n:import": "tsx scripts/translations-review.ts import",
    "kb:fetch-grapes": "tsx scripts/kb/fetch-grapes.ts",
    "kb:extract-grapes": "tsx scripts/kb/extract-grapes.ts",
    "kb:fetch-grape-articles": "tsx scripts/kb/fetch-grape-articles.ts",
    "kb:build-grapes": "tsx scripts/kb/build-grapes.ts",
    "kb:score": "tsx scripts/kb/data-score.ts",
    "kb:fetch-appellation-areas": "tsx scripts/kb/fetch-appellation-areas.ts",
    "kb:fetch-register-documents": "tsx scripts/kb/fetch-register-documents.ts",
    "kb:fetch-register-links": "tsx scripts/kb/fetch-register-links.ts",
    "kb:extract-technical-file-links": "tsx scripts/kb/extract-technical-file-links.ts",
    "kb:fetch-appellations": "tsx scripts/kb/fetch-appellations.ts",
    "kb:fetch-world-appellations": "tsx scripts/kb/fetch-world-appellations.ts",
    "kb:fetch-registers": "tsx scripts/kb/fetch-registers.ts",
    "kb:fetch-article-items": "tsx scripts/kb/fetch-article-items.ts",
    "kb:build-appellations": "tsx scripts/kb/build-appellations.ts",
    "kb:diff-appellations": "tsx scripts/kb/diff-appellations.ts",
    "kb:geocode-appellations": "tsx scripts/kb/geocode-appellations.ts",
    "kb:search-appellation-names": "tsx scripts/kb/search-appellation-names.ts",
    "kb:fetch-grand-crus": "tsx scripts/kb/fetch-grand-crus.ts",
    "kb:fetch-country-wine": "tsx scripts/kb/fetch-country-wine.ts",
    "kb:fetch-climate": "tsx scripts/kb/fetch-climate.ts",
    "kb:fetch-elevation": "tsx scripts/kb/fetch-elevation.ts",
    "kb:fetch-region-figures": "tsx scripts/kb/fetch-region-figures.ts",
    "kb:fetch-ava-rules": "tsx scripts/kb/fetch-ava-rules.ts",
    "kb:fetch-it-regional-figures": "tsx scripts/kb/fetch-it-regional-figures.ts",
    "kb:fetch-region-articles": "tsx scripts/kb/fetch-region-articles.ts",
    "kb:fetch-pt-production": "tsx scripts/kb/fetch-pt-production.ts",
    "kb:fetch-region-infobox-grapes": "tsx scripts/kb/fetch-region-infobox-grapes.ts",
    "kb:read-adelaide": "tsx scripts/kb/read-adelaide.ts",
    "kb:fetch-topics": "tsx scripts/kb/fetch-topics.ts",
    "kb:build-topics": "tsx scripts/kb/build-topics.ts",
    "kb:fetch-grape-images": "tsx scripts/kb/fetch-grape-images.ts",
    "kb:fetch-soil": "tsx scripts/kb/fetch-soil.ts",
    "kb:fetch-topic-images": "tsx scripts/kb/fetch-topic-images.ts",
    "kb:fetch-wineries": "tsx scripts/kb/fetch-wineries.ts",
    "kb:build-map": "tsx scripts/kb/build-map.ts",
    "kb:check-pairing-sources": "tsx scripts/kb/check-pairing-sources.ts",
    "kb:load": "tsx scripts/kb/load.ts",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" --max-warnings 0",
    "migrations:check": "tsx scripts/check-migrations.ts",
    "mirror:build": "tsx scripts/build-public-mirror.ts",
    "notices:check": "tsx scripts/generate-notices.ts --check",
    "notices:generate": "tsx scripts/generate-notices.ts",
    "openapi:check": "tsx scripts/export-openapi.ts --check",
    "openapi:generate": "tsx scripts/export-openapi.ts",
    "perf": "playwright test --project=performance",
    "prepare": "git config core.hooksPath .githooks || true",
    "scan:release": "tsx scripts/scan-public-release.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "test": "pnpm --workspace-concurrency=1 -r --if-present test && pnpm test:scripts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "test:auth-emulator": "firebase emulators:exec --only auth --project demo-vadevi \"tsx scripts/probe-auth-emulator.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.scripts.json && tsc --noEmit --project tsconfig.e2e.json && pnpm -r --if-present typecheck",
    "validate:env": "tsx scripts/validate-env.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "*",
    "@playwright/test": "^1.62.1",
    "@types/node": "*",
    "concurrently": "*",
    "dotenv": "*",
    "eslint": "*",
    "eslint-plugin-react-hooks": "*",
    "eslint-plugin-react-refresh": "*",
    "firebase-tools": "^15.32.1",
    "globals": "*",
    "prettier": "*",
    "tsx": "*",
    "typescript": "6.0.3",
    "typescript-eslint": "*",
    "vitest": "catalog:",
    "wrangler": "^4.151.3",
    "zod": "*",
    "zxing-wasm": "^3.1.3"
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Va de Vi API",
    "version": "0.1.0",
    "description": "Space-scoped API contracts for the private Va de Vi application."
  },
  "components": {
    "securitySchemes": {
      "FirebaseBearer": {
        "bearerFormat": "Firebase ID token",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              },
              "service": {
                "type": "string",
                "enum": [
                  "vadevi-api"
                ]
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$/i"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "status",
              "service",
              "version",
              "timestamp"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "RuntimeConfigResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "appEnvironment": {
                "type": "string",
                "enum": [
                  "local",
                  "preview",
                  "production"
                ]
              },
              "firebase": {
                "type": "object",
                "properties": {
                  "apiKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authDomain": {
                    "type": "string",
                    "minLength": 1
                  },
                  "emulatorHost": {
                    "type": "string",
                    "minLength": 1
                  },
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "apiKey",
                  "authDomain",
                  "projectId"
                ],
                "additionalProperties": false
              },
              "features": {
                "type": "object",
                "properties": {
                  "assistant": {
                    "type": "boolean"
                  },
                  "externalResearch": {
                    "type": "boolean"
                  },
                  "priceLookup": {
                    "type": "boolean"
                  },
                  "voiceInput": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "assistant",
                  "externalResearch",
                  "priceLookup",
                  "voiceInput"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "appEnvironment",
              "firebase",
              "features"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "BootstrapResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "features": {
                "type": "object",
                "properties": {
                  "assistant": {
                    "type": "boolean"
                  },
                  "externalResearch": {
                    "type": "boolean"
                  },
                  "priceLookup": {
                    "type": "boolean"
                  },
                  "voiceInput": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "assistant",
                  "externalResearch",
                  "priceLookup",
                  "voiceInput"
                ],
                "additionalProperties": false
              },
              "spaces": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "admin",
                        "member"
                      ]
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "personal",
                        "couple",
                        "group"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "role",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "user": {
                "type": "object",
                "properties": {
                  "activeSpaceId": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "onboardingComplete": {
                    "type": "boolean"
                  },
                  "preferredLocale": {
                    "type": "string",
                    "enum": [
                      "ca",
                      "es",
                      "fr",
                      "en",
                      "it",
                      "pt-PT",
                      "nl",
                      "de"
                    ]
                  }
                },
                "required": [
                  "activeSpaceId",
                  "displayName",
                  "id",
                  "onboardingComplete",
                  "preferredLocale"
                ],
                "additionalProperties": false
              },
              "versions": {
                "type": "object",
                "properties": {
                  "api": {
                    "type": "string",
                    "minLength": 1
                  },
                  "i18nCatalog": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tastingOntology": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "api",
                  "i18nCatalog",
                  "tastingOntology"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "features",
              "spaces",
              "user",
              "versions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "AUTH_REQUIRED",
          "AUTH_INVALID",
          "FORBIDDEN",
          "NOT_FOUND",
          "VALIDATION_FAILED",
          "VERSION_CONFLICT",
          "IDEMPOTENCY_CONFLICT",
          "RATE_LIMITED",
          "QUOTA_EXHAUSTED",
          "FEATURE_UNAVAILABLE",
          "EXTERNAL_SOURCE_UNAVAILABLE",
          "MEDIA_REJECTED",
          "SYNC_CURSOR_EXPIRED",
          "INVITE_INVALID",
          "INVITE_EXPIRED",
          "INTERNAL_ERROR"
        ]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "activeSpaceId": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "completeOnboarding": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "preferredLocale": {
            "type": "string",
            "enum": [
              "ca",
              "es",
              "fr",
              "en",
              "it",
              "pt-PT",
              "nl",
              "de"
            ]
          }
        },
        "additionalProperties": false
      },
      "SpaceDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "joinedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "admin",
                        "member"
                      ]
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0,
                      "exclusiveMinimum": true
                    }
                  },
                  "required": [
                    "displayName",
                    "id",
                    "joinedAt",
                    "role",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "space": {
                "type": "object",
                "properties": {
                  "defaultLocale": {
                    "type": "string",
                    "enum": [
                      "ca",
                      "es",
                      "fr",
                      "en",
                      "it",
                      "pt-PT",
                      "nl",
                      "de"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "admin",
                      "member"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "personal",
                      "couple",
                      "group"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  }
                },
                "required": [
                  "defaultLocale",
                  "id",
                  "name",
                  "role",
                  "type",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "members",
              "space"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "CreateSpaceRequest": {
        "type": "object",
        "properties": {
          "defaultLocale": {
            "type": "string",
            "enum": [
              "ca",
              "es",
              "fr",
              "en",
              "it",
              "pt-PT",
              "nl",
              "de"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "couple",
              "group"
            ]
          }
        },
        "required": [
          "defaultLocale",
          "name",
          "type"
        ],
        "additionalProperties": false
      },
      "CreateInvitationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "intendedRole": {
                "type": "string",
                "enum": [
                  "admin",
                  "member"
                ]
              },
              "invitationPath": {
                "type": "string",
                "pattern": "^\\/invitations\\/[A-Za-z0-9_-]{43}$"
              },
              "spaceId": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              }
            },
            "required": [
              "expiresAt",
              "id",
              "intendedRole",
              "invitationPath",
              "spaceId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "CreateInvitationRequest": {
        "type": "object",
        "properties": {
          "intendedRole": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        },
        "required": [
          "intendedRole"
        ],
        "additionalProperties": false
      },
      "InvitationPreviewResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "intendedRole": {
                "type": "string",
                "enum": [
                  "admin",
                  "member"
                ]
              },
              "inviterDisplayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "spaceName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "spaceType": {
                "type": "string",
                "enum": [
                  "couple",
                  "group"
                ]
              }
            },
            "required": [
              "expiresAt",
              "intendedRole",
              "inviterDisplayName",
              "spaceName",
              "spaceType"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "RemoveMemberRequest": {
        "type": "object",
        "properties": {
          "baseVersion": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "status": {
            "type": "string",
            "enum": [
              "removed"
            ]
          }
        },
        "required": [
          "baseVersion",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Runtime"
        ],
        "summary": "Check the API process without authentication",
        "responses": {
          "200": {
            "description": "The API process is available.",
            "headers": {
              "X-Request-Id": {
                "description": "Opaque request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/runtime-config": {
      "get": {
        "operationId": "getRuntimeConfig",
        "tags": [
          "Runtime"
        ],
        "summary": "Get non-secret browser and feature configuration",
        "responses": {
          "200": {
            "description": "Public environment, Firebase web, and feature configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/bootstrap": {
      "get": {
        "operationId": "getBootstrap",
        "tags": [
          "Session"
        ],
        "summary": "Create or load the authenticated user's private bootstrap state",
        "security": [
          {
            "FirebaseBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The authenticated user, active memberships, and runtime feature state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "401": {
            "description": "A valid Firebase ID token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "patch": {
        "operationId": "updateProfile",
        "tags": [
          "Session"
        ],
        "summary": "Update the authenticated profile or active Space",
        "security": [
          {
            "FirebaseBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated bootstrap state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "400": {
            "description": "The profile update is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "A valid Firebase ID token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The requested active Space is not available to this user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spaces": {
      "post": {
        "operationId": "createSpace",
        "tags": [
          "Spaces"
        ],
        "summary": "Create a couple or group Space",
        "security": [
          {
            "FirebaseBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "required": true,
            "in": "header",
            "name": "Idempotency-Key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSpaceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The Space and its owner membership were created.",
            "headers": {
              "Location": {
                "description": "The new Space resource.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotency-Replayed": {
                "description": "True when a prior successful command was replayed.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "User unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spaces/{spaceId}": {
      "get": {
        "operationId": "getSpace",
        "tags": [
          "Spaces"
        ],
        "summary": "Get one Space and its active memberships",
        "security": [
          {
            "FirebaseBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "required": true,
            "in": "path",
            "name": "spaceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized Space detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Space not available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spaces/{spaceId}/invitations": {
      "post": {
        "operationId": "createSpaceInvitation",
        "tags": [
          "Invitations"
        ],
        "summary": "Create a seven-day single-use invitation link",
        "security": [
          {
            "FirebaseBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "required": true,
            "in": "path",
            "name": "spaceId"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "required": true,
            "in": "header",
            "name": "Idempotency-Key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The raw invitation capability is returned once through its path and is never stored.",
            "headers": {
              "Location": {
                "description": "The shareable invitation path.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotency-Replayed": {
                "description": "True when replayed.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateInvitationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Space not available or invitation capacity reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invitations/{token}/preview": {
      "get": {
        "operationId": "previewSpaceInvitation",
        "tags": [
          "Invitations"
        ],
        "summary": "Preview a valid invitation capability without authentication",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "required": true,
            "in": "path",
            "name": "token"
          }
        ],
        "responses": {
          "200": {
            "description": "Safe invitation preview.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreviewResponse"
                }
              }
            }

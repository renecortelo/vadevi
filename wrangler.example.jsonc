{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vadevi-local-placeholder",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/openapi.json", "/runtime-config"],
    // Client-side routes such as /memory and /invitations/:token must serve the
    // app shell. Without this an invitation link — the only way an invitation is
    // shared — returns a 404 envelope on first visit.
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vadevi-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vadevi-local-media",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "0.1.0",
    "AI_PROVIDER": "none",
    "EXTERNAL_API_USER_AGENT": "VaDeVi/0.1 (https://example.invalid/contact)",
    "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
    "FIREBASE_AUTH_DOMAIN": "localhost",
    "FIREBASE_PROJECT_ID": "demo-vadevi",
    "FIREBASE_WEB_API_KEY": "local-emulator-placeholder",
    "RESEARCH_PROVIDER": "none",
  },
}
